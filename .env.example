# TELELENS configuration — copy to .env and fill in. Placeholders only; never
# commit real credentials.

# --- ClickHouse (live mode) -------------------------------------------------
# HTTP interface of the SigNoz ClickHouse. NOTE: the default Foundry compose
# does not publish this port to the host; either add "8123:8123" to the
# clickhouse service ports, or run telelens inside the compose network.
CLICKHOUSE_HTTP_URL=http://localhost:8123

# STRONGLY RECOMMENDED: a dedicated read-only user, so the profiler
# *physically cannot* mutate telemetry (product invariant NFR-2).
# Create it with:
#   CREATE USER telelens_ro IDENTIFIED BY '<choose-a-password>';
#   GRANT SELECT ON signoz_traces.* TO telelens_ro;
#   GRANT SELECT ON signoz_logs.*   TO telelens_ro;
#   GRANT SELECT ON signoz_metrics.* TO telelens_ro;
#   GRANT SELECT ON system.tables   TO telelens_ro;   -- schema detection
# The profilers need nothing more. If you also want to re-run the
# reproduction queries from the evidence files (assets/*.md), additionally:
#   GRANT SELECT ON system.parts    TO telelens_ro;   -- storage-size checks
#   GRANT SELECT ON system.part_log TO telelens_ro;   -- merge-activity checks
CLICKHOUSE_USER=telelens_ro
CLICKHOUSE_PASSWORD=changeme

# --- SigNoz API (live mode, GET only) ----------------------------------------
SIGNOZ_API_URL=http://localhost:8080
# API key from SigNoz UI (Settings → API Keys). Viewer role is sufficient:
# telelens only issues GETs for dashboards and rules.
SIGNOZ_API_KEY=

# --- Pricing & scan ----------------------------------------------------------
# Your storage/ingest price per uncompressed GB, in dollars.
COST_PER_GB=0.30
# Scan window in days.
TELELENS_WINDOW_DAYS=7
# Where generated files land (waste-report.md, findings.json, configs).
TELELENS_OUT_DIR=out

# --- Optional / experimental --------------------------------------------------
# MCP evaluation hook (ideas-board #11666): POST the findings summary to a
# SigNoz MCP endpoint after each scan. Leave empty to disable.
TELELENS_MCP_URL=
