        "queryType": "clickhouse_sql",
        "id": "49006e67-cac5-49ca-ba65-249eda743a4f",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "disabled": false,
              "dataSource": "metrics",
              "source": "",
              "stepInterval": 60,
              "filter": {
                "expression": ""
              },
              "functions": [],
              "groupBy": [],
              "having": {
                "expression": ""
              },
              "legend": "",
              "limit": null,
              "orderBy": []
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [
          {
            "disabled": false,
            "legend": "",
            "name": "A",
            "query": "SELECT round(sum(value)/1e9 * (2592000 / ($end_timestamp - $start_timestamp)) * toFloat64($cost_per_gb), 2) AS value FROM signoz_meter.distributed_samples WHERE metric_name IN ('signoz.meter.span.size','signoz.meter.log.size','signoz.meter.metric.datapoint.size') AND unix_milli >= {{.start_timestamp_ms}} AND unix_milli <= {{.end_timestamp_ms}}"
          }
        ],
